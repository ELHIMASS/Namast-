# Modèle du fichier .env à créer sur le NAS, à côté de docker-compose.yml.
# Ne jamais versionner le .env rempli : le dépôt est public.

# Mot de passe de la base Postgres qui tourne dans le conteneur. Le générer
# avec :  openssl rand -hex 24
#
# En hexadécimal, et non en base64 : ce mot de passe est inséré dans une URL de
# connexion, où « / » et « + » — que produit base64 — cassent l'analyse de
# l'URL. Prisma répond alors « P1013 invalid port number in database URL ».
POSTGRES_PASSWORD=

# Mot de passe d'accès à l'espace pro (/admin). Reprendre celui du .env actuel.
ADMIN_PASSWORD=

# DATABASE_URL n'est pas à renseigner ici : docker-compose la construit à
# partir de POSTGRES_PASSWORD, en pointant vers la base du conteneur.

# Clé API Google Places & ID du salon pour la récupération automatique des avis Google (Optionnel)
GOOGLE_PLACES_API_KEY=
GOOGLE_PLACE_ID=

