// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
  // rhel-openssl-3.0.x est le binaire des fonctions serverless (Netlify,
  // Vercel), qui tournent sur Amazon Linux alors que la compilation se fait
  // sur Ubuntu. Sans lui : « Query engine library for current platform could
  // not be found » au premier appel à la base.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StatutRendezVous {
  EN_ATTENTE
  CONFIRME
  REFUSE
  ANNULE
  TERMINE
}

enum CategoriePrestation {
  COUPE
  COULEUR
  SOIN
  HEAD_SPA
  MASSAGE
  EVENEMENTIEL
}

enum Profil {
  FEMME
  HOMME
  ENFANT
}

// Les deux formules de coiffure femme. Les prestations hors formule
// (Head Spa, massages, homme, enfant) laissent ce champ vide.
enum Formule {
  PRIVILEGE
  BIEN_ETRE
}

enum LongueurCheveux {
  COURT
  CARRE
  MI_LONG
  LONG
  TRES_LONG
}

enum Densite {
  FIN
  NORMAL
  EPAIS
}

enum GroupeOption {
  RITUEL_FEMME
  BIEN_ETRE
  COIFFAGE
  COULEUR
  HOMME
}

model Client {
  id             String   @id @default(cuid())
  nom            String
  prenom         String
  // Facultatif et non unique : une partie du fichier clientes n'a pas de
  // numéro, et des proches partagent la même ligne fixe. La cliente est
  // identifiée par son prénom et son nom, plus par son téléphone.
  telephone      String?
  email          String
  dateNaissance  DateTime?
  commentConnue  String?
  notes          String?
  createdAt      DateTime @default(now())

  rendezVous     RendezVous[]
}

model Prestation {
  id                     String              @id @default(cuid())
  nom                    String
  description            String?
  categorie              CategoriePrestation
  profil                 Profil              @default(FEMME)
  prixCentimes           Int
  dureeMinutes           Int
  tempsNettoyageMinutes  Int                 @default(10)
  actif                  Boolean             @default(true)
  ordre                  Int                 @default(0)
  estLissage             Boolean             @default(false)
  formule                Formule?

  variantesLongueur      PrestationLongueur[]
  rendezVousPrestations  RendezVousPrestation[]
}

// Prix/durée spécifiques selon la longueur de cheveux, pour les prestations
// qui varient (coiffure et coloration femmes). Absent = la prestation utilise
// son prix/durée de base (ex: prestations homme, enfant, bien-être).
model PrestationLongueur {
  id           String          @id @default(cuid())
  prestationId String
  prestation   Prestation      @relation(fields: [prestationId], references: [id], onDelete: Cascade)
  longueur     LongueurCheveux
  prixCentimes Int
  dureeMinutes Int

  @@unique([prestationId, longueur])
}

// Matrice de tarifs pour le lissage Belmakosmetik (longueur x densité).
model LissageTarif {
  id           String          @id @default(cuid())
  longueur     LongueurCheveux
  densite      Densite
  prixCentimes Int
  dureeMinutes Int

  @@unique([longueur, densite])
}

// Options additionnelles cochables (rituel détente, massages, wavy...).
// prixCentimes est null quand le tarif dépend de la longueur (voir variantesLongueur).
model Option {
  id           String       @id @default(cuid())
  nom          String
  description  String?
  groupe       GroupeOption
  prixCentimes Int?
  dureeMinutes Int
  actif        Boolean      @default(true)
  ordre        Int          @default(0)

  variantesLongueur OptionLongueur[]
  rendezVousOptions RendezVousOption[]
}

model OptionLongueur {
  id           String          @id @default(cuid())
  optionId     String
  option       Option          @relation(fields: [optionId], references: [id], onDelete: Cascade)
  longueur     LongueurCheveux
  prixCentimes Int

  @@unique([optionId, longueur])
}

model RendezVous {
  id             String           @id @default(cuid())
  // Code communiqué à la cliente pour retrouver son rendez-vous (ex. NAM-7K2P).
  // Nullable : les rendez-vous créés avant cette fonctionnalité n'en ont pas.
  code           String?          @unique
  clientId       String
  client         Client           @relation(fields: [clientId], references: [id])
  statut         StatutRendezVous @default(EN_ATTENTE)
  estNouvelleCliente Boolean      @default(false)
  // Rendez-vous récurrents : toutes les occurrences d'une même série
  // partagent cet identifiant (celui de la première). Les occurrences sont
  // de vrais rendez-vous, chacun modifiable et annulable séparément.
  serieId        String?
  dateDebut      DateTime
  dateFin        DateTime
  message        String?
  motifRefus     String?
  creeParAdmin    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  prestations    RendezVousPrestation[]

  @@index([serieId])
}

model RendezVousPrestation {
  id           String           @id @default(cuid())
  rendezVousId String
  rendezVous   RendezVous       @relation(fields: [rendezVousId], references: [id], onDelete: Cascade)
  prestationId String
  prestation   Prestation       @relation(fields: [prestationId], references: [id])
  ordre        Int              @default(0)
  longueur     LongueurCheveux?
  densite      Densite?

  options      RendezVousOption[]
}

// Jours de fermeture posés par le salon (congés, absences). Les deux bornes
// sont incluses : une fermeture d'un seul jour a la même date des deux côtés.
model Fermeture {
  id        String   @id @default(cuid())
  dateDebut DateTime @db.Date
  dateFin   DateTime @db.Date
  motif     String?
  createdAt DateTime @default(now())

  @@index([dateDebut, dateFin])
}

model RendezVousOption {
  id                     String               @id @default(cuid())
  rendezVousPrestationId String
  rendezVousPrestation   RendezVousPrestation @relation(fields: [rendezVousPrestationId], references: [id], onDelete: Cascade)
  optionId               String
  option                 Option               @relation(fields: [optionId], references: [id])
}
